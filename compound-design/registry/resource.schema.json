{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compound.design/schemas/resource-registry.schema.json",
  "title": "Compound Design Resource Registry",
  "type": "object",
  "required": ["framework", "release", "evidencePolicy", "resources"],
  "properties": {
    "framework": { "const": "Compound Design" },
    "release": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "releaseTheme": { "type": "string" },
    "releaseStage": { "enum": ["stable", "candidate"] },
    "pluginVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "updatedAt": { "type": "string" },
    "evidencePolicy": {
      "type": "object",
      "required": ["currentLevel", "runtimeUplift", "rule"],
      "properties": {
        "currentLevel": { "enum": ["E0", "E1", "E2", "E3", "E4"] },
        "runtimeUplift": { "type": "string" },
        "rule": { "type": "string", "minLength": 20 },
        "stableEvidenceBaseline": { "type": "string" },
        "versionRule": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "version", "job", "triggers", "nonGoals", "upstream", "provenance", "cdqi", "cel", "runtimeUplift", "evidenceDebt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "publicName": { "type": "string" },
          "kind": { "enum": ["agent", "skill", "orchestrator", "resource"] },
          "status": { "enum": ["active", "superseded"] },
          "supersedes": { "type": ["string", "null"] },
          "supersededBy": { "type": ["string", "null"] },
          "path": { "type": "string" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
          "job": { "type": "string", "minLength": 20 },
          "triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "nonGoals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "upstream": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "provenance": { "type": "string" },
          "cdqi": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 10 }, { "type": "null" }] },
          "cel": { "enum": ["E0", "E1", "E2", "E3", "E4"] },
          "runtimeUplift": { "type": "string" },
          "evidenceDebt": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
