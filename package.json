{
  "name": "compoundmetrics",
  "version": "0.3.0-alpha.1",
  "private": true,
  "description": "Compound Design — design engineering work system, durable learning system, plugin and evidence system.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cd:lint": "node compound-design/tools/cd-lint.mjs --self-test",
    "cd:evals": "node compound-design/tools/cd.mjs contracts",
    "e2": "node compound-design/quality/e2/scripts/e2.mjs",
    "e2:install": "node compound-design/quality/e2/scripts/e2.mjs install",
    "e2:check": "node compound-design/quality/e2/scripts/e2.mjs self-test && node compound-design/quality/e2/scripts/e2.mjs validate && node compound-design/quality/e2/scripts/e2.mjs freeze && node compound-design/quality/e2/scripts/e2.mjs plan-runs",
    "e2:runtime:DANGEROUS-PAID": "node compound-design/quality/e2/scripts/e2.mjs paid-runtime",
    "cd:registry": "node compound-design/tools/cd.mjs registry",
    "cd:plugin": "node compound-design/tools/cd.mjs plugin",
    "cd:claims": "node compound-design/tools/cd.mjs claims",
    "cd:selftest": "node compound-design/tools/cd.mjs selftest",
    "cd:setup-check": "node compound-design/tools/cd.mjs setup-check",
    "cd:discover": "node compound-design/tools/cd.mjs discover",
    "cd:all": "npm run cd:lint && npm run cd:registry && npm run cd:evals && npm run cd:plugin && npm run cd:claims && npm run cd:selftest"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "geist": "^1.7.2",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5"
  },
  "license": "UNLICENSED"
}
